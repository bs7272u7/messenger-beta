# 앱 보안
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# PostgreSQL: DATABASE_URL 또는 개별 DB_* 설정 중 하나를 사용합니다.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=messenger_beta
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_SSLMODE=prefer

# 운영·관리자
ADMIN_EMAIL=admin@example.com
ADMIN_ACCESS_KEY_HASH=
SUPPORT_EMAIL=support@example.com

# 이메일
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 파일 저장소 (Cloudinary 사용 시에만 모두 설정)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 오류 추적 및 웹 푸시
SENTRY_DSN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# 선택: GitHub 업데이트 조회
GITHUB_REPOSITORY=bs7272u7/messenger-beta
GITHUB_TOKEN=
